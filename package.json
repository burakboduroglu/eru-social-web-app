{
  "name": "social-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "bun --watch server/index.ts",
    "build": "bun run typecheck && vite build",
    "start": "bun server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:check": "bun scripts/db-check.ts",
    "db:studio": "bun --bun x drizzle-kit studio",
    "db:invite": "bun scripts/create-invite.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-router": "^1.0.0",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.6.0",
    "react-hook-form": "^7.54.0",
    "@emoji-mart/data": "^1.2.0",
    "emoji-mart": "^5.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
